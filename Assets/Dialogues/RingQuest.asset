  m_Script: {fileID: 11500000, guid: 0eeeff2bf5745cf49be9c51824de2360, type: 3}
  m_Name: RingQuest
  m_EditorClassIdentifier: Assembly-CSharp::DialogueObject
  nodes:
  - name: offer
    text: A bat stole my silver ring and fled south. Will you bring it back?
    answers:
    - text: I'll get it back.
      next: accepted
      action: 1
    - text: Not right now.
      next: declined
      action: 0
  - name: accepted
    text: Thank you! Be careful out there.
    answers: []
  - name: declined
    text: I understand. Come back if you change your mind.
    answers: []
  - name: reminder
    text: Please find my silver ring. The bat fled south.
    answers: []
  - name: completed
    text: My ring! Thank you, you have earned this.
    answers: []
  - name: after
    text: Thank you again for the ring.
    answers: []
